{
  "name": "auto-ticket",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "setup": "uv sync && uv run playwright install chromium && pnpm --dir web install",
    "setup:browsers": "uv run playwright install chromium",
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"pnpm run dev:api\" \"pnpm run dev:worker\" \"pnpm run dev:web\"",
    "dev:api": "uv run python scripts/serve_api.py --host 127.0.0.1 --port 8000",
    "dev:worker": "uv run python scripts/worker.py",
    "dev:worker:headed": "uv run python scripts/worker.py --no-headless",
    "dev:web": "pnpm --dir web run dev",
    "build": "pnpm --dir web run build",
    "start:web": "pnpm --dir web run start",
    "lint": "pnpm --dir web run lint",
    "typecheck": "pnpm --dir web run typecheck",
    "test": "uv run pytest",
    "test:web": "pnpm --dir web run test",
    "invariants": "uv run python scripts/check_invariants.py",
    "check": "pnpm run invariants && pnpm run test && pnpm run typecheck && pnpm run lint && pnpm run test:web && pnpm --dir web run check:contract"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  }
}
